<?xml version="1.0" encoding="utf-8"?>
<!--
    English is the default locale; the German translation lives in values-de.
    The app was German-only until 0.5.0; see CHANGELOG.

    Keep the two files in step. A string added here and forgotten there falls back
    to English mid-sentence, which is worse than either language on its own.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">Sudomnia</string>

    <string name="new_game">New game</string>
    <string name="choose_level">Difficulty</string>
    <string name="level_easy">Easy</string>
    <string name="level_medium">Medium</string>
    <string name="level_hard">Hard</string>
    <string name="level_expert">Expert</string>

    <plurals name="clue_count">
        <item quantity="one">%1$d clue</item>
        <item quantity="other">%1$d clues</item>
    </plurals>

    <string name="generating">Generating puzzle…</string>
    <string name="pad_notes">Notes</string>
    <string name="erase">Erase</string>
    <string name="undo">Undo</string>
    <string name="redo">Redo</string>
    <string name="cancel">Cancel</string>

    <string name="solved_title">Solved!</string>
    <string name="solved_body">%1$s · %2$s</string>
    <string name="solved_new_game">Next puzzle</string>

    <!-- Pause: stops the clock and hides the board -->
    <string name="paused_pause">Pause</string>
    <string name="paused_title">Paused</string>
    <string name="paused_resume">Resume</string>

    <!-- Branch: a trial run for when no cell is forced any more -->
    <string name="branch_start">Start branch</string>
    <string name="branch_empty">Branch open – enter your attempt</string>
    <plurals name="branch_cells">
        <item quantity="one">Branch · %1$d cell on trial</item>
        <item quantity="other">Branch · %1$d cells on trial</item>
    </plurals>
    <string name="branch_discard">Discard</string>
    <string name="branch_commit">Keep</string>

    <string name="hint">Hint</string>
    <string name="hint_locate_forced">This cell can be worked out right now.</string>
    <string name="hint_locate_reveal" tools:ignore="PluralsCandidate">Nothing is forced at the moment. With %1$d candidates, this cell has the fewest.</string>
    <string name="hint_show_digit">Show digit</string>
    <string name="hint_reveal_naked" tools:ignore="PluralsCandidate">Only the %1$d is left for this cell.</string>
    <string name="hint_reveal_hidden">In %1$s, this is the only place for the %2$d.</string>
    <string name="hint_reveal_bare" tools:ignore="PluralsCandidate">The %1$d belongs here.</string>
    <string name="hint_apply">Enter it</string>
    <string name="hint_dismiss">Close</string>
    <string name="hint_dead_end">With the entries so far, this puzzle can no longer be solved. Undo some moves.</string>

    <string name="unit_row">row %1$d</string>
    <string name="unit_col">column %1$d</string>
    <string name="unit_box">box %1$d</string>

    <string name="stats">Statistics</string>
    <string name="stats_solved">Solved</string>
    <string name="stats_started">Started</string>
    <string name="stats_best">Best time</string>
    <string name="stats_no_aids">without aids</string>
    <string name="stats_no_hints">without hints</string>
    <string name="stats_none">–</string>
    <string name="stats_total">Solved in total: %1$d</string>
    <string name="stats_reset">Reset</string>
    <string name="stats_reset_ask">Clear all counters?</string>
    <string name="stats_reset_yes">Clear</string>
    <string name="solved_no_hints">without hints</string>
    <plurals name="solved_hints">
        <item quantity="one">%1$d hint</item>
        <item quantity="other">%1$d hints</item>
    </plurals>

    <string name="settings">Aids</string>
    <string name="settings_intro">Each of these displays takes part of the work off your hands. Switch off whatever you want to do yourself.</string>
    <string name="setting_conflicts">Show conflicts</string>
    <string name="setting_conflicts_hint">Tells you immediately whether a digit is possible in a cell at all</string>
    <string name="setting_same_digit">Highlight the same digit</string>
    <string name="setting_same_digit_hint">Tints every cell holding the same digit as the selected one</string>
    <string name="setting_peers">Highlight row, column, box</string>
    <string name="setting_peers_hint">Tints the units of the selected cell</string>
    <string name="setting_dim_digits">Dim finished digits</string>
    <string name="setting_dim_digits_hint">Greys out a digit on the keypad once it has been placed nine times</string>
    <string name="settings_done">Done</string>
    <string name="no_aids">without aids</string>
    <string name="full_but_wrong">The grid is full, but not yet right.</string>

    <!-- Update. Only reachable in the selfhosted flavour; the Play build shows the
         version line without a button. -->
    <string name="update_banner">Version %1$s is here</string>
    <string name="update_banner_loading">Downloading version %1$s…</string>
    <string name="update_install">Install</string>
    <string name="update_check">Check for updates</string>
    <string name="update_checking">Checking…</string>
    <string name="update_downloading">Downloading…</string>
    <string name="update_version">App version %1$s</string>
    <string name="update_current">Up to date</string>
    <string name="update_failed">Failed: %1$s</string>
    <string name="update_available_note">Version %1$s available</string>

    <!-- Diagnostics -->
    <string name="diag_title">Error report</string>
    <string name="diag_hint">Pass on the log and crash reports when something is stuck</string>
    <string name="diag_share">Share</string>

</resources>
