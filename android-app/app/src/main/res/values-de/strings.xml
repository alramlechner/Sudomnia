<?xml version="1.0" encoding="utf-8"?>
<!--
    Deutsche Uebersetzung. Die Vorlage ist values/strings.xml (Englisch, Standard).

    Beide Dateien muessen denselben Satz an Namen haben: fehlt hier einer, faellt die
    App mitten im Satz auf Englisch zurueck, und das ist schlechter als eine der
    beiden Sprachen ganz.
-->
