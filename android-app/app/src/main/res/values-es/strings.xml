<?xml version="1.0" encoding="utf-8"?>
<!--
    Traducción al español. La plantilla es values/strings.xml (inglés, predeterminado).

    Ambos archivos deben tener el mismo conjunto de nombres: si falta uno aquí, la
    app cae a mitad de frase al inglés, y eso es peor que cualquiera de los dos
    idiomas por separado.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
