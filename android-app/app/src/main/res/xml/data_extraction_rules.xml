<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same selection for cloud backup and for device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="sudomnia.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="sudomnia.xml" />
    </device-transfer>
</data-extraction-rules>
