<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keine einzige Berechtigung. Das Spiel sammelt nichts, sendet nichts und kennt
         keinen Server; es kann technisch gar nichts irgendwohin schicken.

         INTERNET und REQUEST_INSTALL_PACKAGES stehen ausschliesslich im Manifest der
         selfhosted-Variante (src/selfhosted/AndroidManifest.xml), die sich selbst vom
         Haus-Server aktualisiert. Der Play-Build enthaelt den Code dazu gar nicht —
         Google verbietet Selbst-Updates ausserhalb des Stores. -->

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sudomnia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/Theme.Sudomnia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
