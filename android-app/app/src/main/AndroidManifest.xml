<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Not a single permission. The game collects nothing, sends nothing and knows
         no server; it technically cannot send anything anywhere.

         INTERNET and REQUEST_INSTALL_PACKAGES exist exclusively in the manifest of
         the selfhosted flavour (src/selfhosted/AndroidManifest.xml), which updates
         itself from the house server. The Play build doesn't contain that code at
         all — Google forbids self-updates outside the store. -->

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sudomnia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/Theme.Sudomnia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares a cache file via a content:// URI (required since Android 7). Used by
             the "Fehler melden" diagnostics report (both flavours) and, in the selfhosted
             flavour only, to hand the downloaded update APK to the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
