<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Das Spiel selbst ist weiterhin vollstaendig offline: es sammelt nichts, sendet
         nichts und kennt keinen Server. Die beiden Berechtigungen gehoeren ausschliesslich
         zum Auto-Update (siehe update/UpdateClient.kt): die App holt latest.json und das
         APK per mTLS vom EnergyControl-Server und uebergibt es dem Paketinstaller. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sudomnia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/Theme.Sudomnia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reicht das heruntergeladene APK aus dem Cache an den Paketinstaller weiter.
             Ohne FileProvider waere das eine file:// -Uri und damit seit Android 7 verboten. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
