<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the selfhosted flavour: the app fetches new versions itself from the
    EnergyControl server at home (see update/UpdateClient.kt). Both permissions
    belong exclusively to that.

    The FileProvider itself is declared in src/main now — the diagnostics report
    ("Fehler melden") shares a cache file the same way in both flavours and needs
    it too, so it can't live only here.

    In the Play build, this file doesn't exist and neither does the update code —
    Google forbids apps from the store updating themselves any other way, and a
    Sudoku wouldn't get REQUEST_INSTALL_PACKAGES declared for it anyway.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
