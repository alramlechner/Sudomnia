# Copy to keystore.properties (untracked) to sign release builds.
# Without this file the release build is produced unsigned.
#
# Create a signing key once:
#   keytool -genkeypair -v -keystore sudomnia-upload.jks \
#           -alias upload -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file OUTSIDE the repository and back it up. If Sudomnia is ever
# published, losing this key means losing the ability to ship updates under the
# same listing -- there is no recovery.
storeFile=/absolute/path/to/sudomnia-upload.jks
storePassword=
keyAlias=upload
keyPassword=
