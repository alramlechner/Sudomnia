# Play Console service account key -- publishes releases in your name
play-service-account.json

# IDE
.idea/
*.iml
.DS_Store

# Client-Zertifikat fuer den Update-Endpunkt: bleibt lokal, ein privater Schluessel
# gehoert nicht auf GitHub. Die App sucht die Datei zur Laufzeit und laeuft ohne sie
# (nur die Update-Pruefung meldet dann "nicht eingerichtet") -- siehe RELEASING.md.
android-app/app/src/selfhosted/res/raw/*.p12

# Erzeugte Raetsel-Pakete: reine Ausgabe des Generators, jederzeit neu erzeugbar.
generator-cli/generated-puzzles/
generator-cli/run/*.log
