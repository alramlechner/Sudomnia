# Build output
build/
.gradle/
.kotlin/
*.apk
*.aab

# Local configuration -- never commit
local.properties
keystore.properties
*.jks
*.keystore
*.p12
# Play Console service account key -- publishes releases in your name
play-service-account.json

# IDE
.idea/
*.iml
.DS_Store

# Client certificate and pinned server certificate for the update endpoint: both
# stay local. The client certificate is a private key, the server certificate would
# otherwise reveal the server's hostname -- neither belongs on GitHub. The app looks
# for these files at runtime and runs without them (only the update check then reports
# "not configured") -- see RELEASING.md. Both are re-issued together by
# SudomniaClientCertTool.
android-app/app/src/selfhosted/res/raw/*.p12
android-app/app/src/selfhosted/res/raw/server_cert.pem

# Generated puzzle packages: pure generator output, can be regenerated at any time.
generator-cli/generated-puzzles/
generator-cli/run/*.log
